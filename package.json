{
  "name": "todo-panel",
  "displayName": "Todo Panel",
  "description": "A sidebar panel for managing your to-do items",
  "version": "0.2.7",
  "icon": "icon.png",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "todo-panel",
          "title": "Todo Panel",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "todo-panel": [
        {
          "type": "webview",
          "id": "todoPanel.webview",
          "name": "My Todos"
        }
      ]
    },
    "commands": [
      {
        "command": "todoPanel.addTodo",
        "title": "Add Todo",
        "icon": "$(add)"
      },
      {
        "command": "todoPanel.refresh",
        "title": "Sync Jira",
        "icon": "$(sync)"
      },
      {
        "command": "todoPanel.syncGitLab",
        "title": "Todo Panel: Sync GitLab MRs",
        "icon": "$(git-merge)"
      },
      {
        "command": "todoPanel.clearAll",
        "title": "Clear All",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "todoPanel.addTodo",
          "when": "view == todoPanel.webview",
          "group": "navigation"
        },
        {
          "command": "todoPanel.clearAll",
          "when": "view == todoPanel.webview",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \".test-out/test/**/*.test.js\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.0.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.0.0"
  }
}
