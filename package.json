{
  "name": "todo-panel",
  "displayName": "PC Board",
  "description": "PC Board：Jira 看板（五列取自 board 配置，卡片挂 GitLab / Jenkins 交付事实）与 GitLab 看板（待我审 / 我提交的），只读——改状态去 Jira，写操作去 GitLab。",
  "version": "1.0.1",
  "icon": "icon.png",
  "publisher": "your-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/iory2002/QoderTask.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jiraBoard",
          "title": "Jira Board",
          "icon": "$(project)"
        },
        {
          "id": "gitlabBoard",
          "title": "GitLab Board",
          "icon": "$(git-pull-request)"
        }
      ]
    },
    "views": {
      "jiraBoard": [
        {
          "id": "jiraBoard.entry",
          "name": "Jira Board"
        }
      ],
      "gitlabBoard": [
        {
          "id": "gitlabBoard.entry",
          "name": "GitLab Board"
        }
      ]
    },
    "commands": [
      {
        "command": "todoPanel.openBoard",
        "title": "Jira Board: Open Board",
        "icon": "$(project)"
      },
      {
        "command": "todoPanel.openMrBoard",
        "title": "GitLab Board: Open Board",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "todoPanel.openSettings",
        "title": "PC Board: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "todoPanel.refresh",
        "title": "Jira Board: Refresh",
        "icon": "$(sync)"
      }
    ],
    "configuration": [
      {
        "id": "jira",
        "title": "PC Board: Jira",
        "properties": {
          "pcBoard.boardId": {
            "type": "number",
            "default": 23,
            "description": "Jira board id。列定义来自该 board 的 configuration。"
          },
          "pcBoard.projects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "NEX2"
            ],
            "description": "看板范围的项目白名单。填项目 key（如 NEX2），不是 issue key；要单独盯一张卡用 pcBoard.extraIssueKeys。不在白名单里的项目不会出现在看板上；白名单外的 repo 映射也不会发请求。"
          },
          "pcBoard.onlyMineByDefault": {
            "type": "boolean",
            "default": true,
            "description": "打开看板时默认只看指派给自己的 issue。只是个视图开关：数据始终全量拉取，切换不会重新请求。"
          },
          "pcBoard.hiddenColumns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "要在看板上隐藏的列名，例如 `To Do`、`In Progress`（大小写与首尾/连续空格不敏感，也可以填列 id）。\n\n一般不用手改：看板顶栏「视图 → 显示列」里直接勾选就会写回这里。\n\n**只影响显示**：卡片仍然全量拉取，活动栏角标、顶栏总数、列外状态计数都不变——隐藏 `To Do` 与 `In Progress` 不会改变「开发中」的数字。\n\n留空 = 显示 Jira 看板配置里的全部列。"
          },
          "pcBoard.pollIntervalSec": {
            "type": "number",
            "default": 60,
            "minimum": 30,
            "maximum": 600,
            "description": "Jira 看板打开时的自动刷新间隔（秒），默认 60。"
          },
          "pcBoard.buildCheckIssueTypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Story",
              "Bug",
              "In-Sprint Bug"
            ],
            "description": "哪些 issue 类型需要看构建。默认 Story、Bug 与 In-Sprint Bug（测试退回后开的子 bug）。其余类型（如 Task、Sub-task）不查 Jenkins，阶段顶格在「已合入」；没写代码却要等构建会让它们永远挂着。"
          },
          "pcBoard.reworkStatuses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "In Progress",
              "Reopened",
              "In Rework",
              "Test Failed"
            ],
            "description": "算「已退回开发 / 返工」的 Jira 状态名。卡片处于这些状态、且本轮还没有新 MR 时，不再显示上一轮的「已构建」，改为「返工中」。大小写与首尾空格不敏感。"
          },
          "pcBoard.extraIssueKeys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "额外钉住的 issue key，示例：[\"NEX2-1100\"]（issue key = 项目 key-编号，不要填项目 key）：仅在 pcBoard.devMode 打开时生效，绕开 sprint 与「只看我的」。"
          },
          "pcBoard.devMode": {
            "type": "boolean",
            "default": false,
            "description": "dev 开关。打开后才会把 pcBoard.extraIssueKeys 里的 issue 钉进看板，用于验收时单独盯一张还没进 sprint 的卡；平时关掉，看板保持干净。"
          },
          "pcBoard.repos": {
            "type": "array",
            "description": "Jira 项目到 GitLab 仓库 / Jenkins job 的映射。没有条目的项目不做阶段追踪，卡片不出现阶段徽章。",
            "default": [
              {
                "jiraProjects": [
                  "NEX2"
                ],
                "gitlabProject": "ultrasoundgeneralimaging/gipc-app",
                "targetBranch": "nexus/dev/7.10.x",
                "jenkinsJobPath": "UltrasoundGeneralImaging/ultrasoundgeneralimaging%2Fgipc-app/nexus%2Fdev%2F7.10.x"
              },
              {
                "jiraProjects": [
                  "NEX"
                ],
                "gitlabProject": "ultrasoundgeneralimaging/gipc-app",
                "targetBranch": "nexus/dev/5.10.x",
                "jenkinsJobPath": "UltrasoundGeneralImaging/ultrasoundgeneralimaging%2Fgipc-app/nexus%2Fdev%2F5.10.x"
              }
            ],
            "items": {
              "type": "object",
              "required": [
                "jiraProjects",
                "gitlabProject",
                "targetBranch"
              ],
              "properties": {
                "jiraProjects": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "该条目服务的 Jira 项目 key。"
                },
                "gitlabProject": {
                  "type": "string",
                  "description": "GitLab 项目路径或数值 id。"
                },
                "targetBranch": {
                  "type": "string",
                  "description": "只有合入这个分支的 MR 才算交付。"
                },
                "jenkinsJobPath": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null,
                  "description": "Jenkins job 路径（用 / 分段，每段已 URL 编码）。为 null 时阶段只到「已合入」。"
                }
              }
            }
          },
          "pcBoard.badge.jira.developmentStatuses": {
            "order": 1,
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Open",
              "In Progress",
              "In review",
              "In Code Review"
            ],
            "markdownDescription": "算「开发中未完成」的 Jira 状态名。大小写与首尾空格不敏感；同一张卡只归一组。"
          },
          "pcBoard.badge.jira.testingStatuses": {
            "order": 2,
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "In Test"
            ],
            "markdownDescription": "算「测试中未完成」的 Jira 状态名。"
          },
          "pcBoard.badge.jira.mode": {
            "order": 3,
            "type": "string",
            "enum": [
              "development",
              "testing"
            ],
            "enumDescriptions": [
              "开发中：Open / In Progress / In review / In Code Review",
              "测试中：In Test"
            ],
            "default": "development",
            "description": "活动栏 Jira 图标上显示哪个数字（取上面两组状态之一）。一个图标只有一处数字位，另一个数字在侧边栏条目里显示。"
          },
          "pcBoard.badge.jira.onlyMine": {
            "order": 4,
            "type": "boolean",
            "default": true,
            "description": "角标只统计指派给自己的 issue。关闭后统计当前 sprint 里的全部卡片。"
          },
          "pcBoard.badge.jira.pollIntervalSec": {
            "order": 5,
            "type": "number",
            "default": 60,
            "minimum": 30,
            "maximum": 1800,
            "description": "看板面板没打开时，Jira 角标的刷新间隔（秒），默认 60。面板打开后改用 pcBoard.pollIntervalSec。"
          }
        }
      },
      {
        "id": "gitlab",
        "title": "PC Board: GitLab",
        "properties": {
          "pcBoard.mrBoard.scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "ultrasoundgeneralimaging/gipc-app@nexus/dev/7.10.x"
            ],
            "markdownDescription": "GitLab 看板的取数范围，每行一条 `仓库路径@目标分支`。\n\n- 例：`ultrasoundgeneralimaging/gipc-app@nexus/dev/7.10.x`\n- 再加一条 5.10.x：`ultrasoundgeneralimaging/gipc-app@nexus/dev/5.10.x`\n\n与 Jira 看板的 `pcBoard.repos` 相互独立。"
          },
          "pcBoard.mrBoard.pollIntervalSec": {
            "type": "number",
            "default": 60,
            "minimum": 30,
            "maximum": 600,
            "description": "GitLab 看板打开时的自动刷新间隔（秒），默认 60。"
          },
          "pcBoard.badge.gitlab.mode": {
            "order": 1,
            "type": "string",
            "enum": [
              "reviewQueue",
              "awaitingOthers"
            ],
            "enumDescriptions": [
              "待我审：审查队列里的 MR 数",
              "等别人审：我提交但还没被其他人批准的 MR 数"
            ],
            "default": "reviewQueue",
            "description": "活动栏 GitLab 图标上显示哪个数字。另一个数字在侧边栏条目里显示。"
          },
          "pcBoard.badge.gitlab.pollIntervalSec": {
            "order": 2,
            "type": "number",
            "default": 60,
            "minimum": 30,
            "maximum": 1800,
            "description": "看板面板没打开时，GitLab 角标的刷新间隔（秒），默认 60。面板打开后改用 pcBoard.mrBoard.pollIntervalSec。"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node scripts/clean-out.js && tsc -p ./ && tsc -p tsconfig.webview.json && node build-webview.js",
    "build:webview": "node build-webview.js",
    "watch:webview": "node build-webview.js --watch",
    "watch": "tsc -watch -p ./",
    "pretest": "node scripts/clean-out.js && tsc -p tsconfig.test.json",
    "test": "node --test \".test-out/test/**/*.test.js\"",
    "package": "npm run compile && node scripts/check-webview-build.js && vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.25.12",
    "preact": "^10.29.8",
    "typescript": "^5.0.0"
  }
}
